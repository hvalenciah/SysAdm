<Window x:Class="SysAdm.Views.UserControls.PermisoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SysAdm.Models"
        Title="Permiso Vista Usuario" Height="600" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Encabezado e Información -->
            <RowDefinition Height="*"/>    <!-- Árbol de Permisos -->
            <RowDefinition Height="Auto"/> <!-- Botones de Acción -->
        </Grid.RowDefinitions>

        <!-- Información del Usuario e Instrucción -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Usuario: " FontSize="11" Foreground="#666666"/>
                <TextBlock x:Name="lblUsuario" Text="BERNARDO DE HUERTA BADILLO" FontSize="11" FontWeight="Bold" Foreground="#333333"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Correo: " FontSize="11" Foreground="#666666"/>
                <TextBlock x:Name="lblCorreo" Text="bdehuerta@aguapuebla.mx" FontSize="11" Foreground="#666666"/>
            </StackPanel>

            <TextBlock Text="Para actualizar los permisos marque las casillas correspondientes:" 
                       FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,5"/>
        </StackPanel>

        <!-- Contenedor del Árbol de Permisos -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" Padding="5" Background="#FFFFFF">
            <TreeView x:Name="treePermisos" BorderThickness="0">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:PermisoNodoModel}" ItemsSource="{Binding Hijos}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" FontSize="12" Foreground="#333333"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <!-- Botones en barra inferior a la derecha -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="80" Height="28" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button Content="Actualizar" Width="80" Height="28" Background="#0078D4" Foreground="White" Click="BtnActualizar_Click"/>
        </StackPanel>
    </Grid>
</Window>