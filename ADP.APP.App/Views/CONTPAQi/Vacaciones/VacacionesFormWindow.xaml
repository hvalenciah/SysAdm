<Window x:Class="SysAdm.Views.UserControls.VacacionesFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Vacaciones CONTPAQi" Height="480" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Id Vacaciones Activas (Solo lectura)" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtId" IsReadOnly="True" Margin="0,0,0,10" Background="#F0F0F0" Height="24"/>

                <TextBlock Text="Número de Trabajador (Solo lectura)" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtNumeroTrabajador" IsReadOnly="True" Margin="0,0,0,10" Background="#F0F0F0" Height="24"/>

                <TextBlock Text="Periodo Vacacional *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtPeriodoVacacional" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Días Otorgados *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtDiasOtorgados" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Días Gozados" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtDiasGozados" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Días Pendientes *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtDiasPendientes" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Vigencia *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <DatePicker x:Name="dtpVigencia" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Usuario Modificación *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtUsuarioModificacion" Margin="0,0,0,10" Height="24"/>

                <CheckBox x:Name="chkActivo" Content="Activo" IsChecked="True" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="80" Height="28" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button Content="Guardar" Width="80" Height="28" Background="#0078D4" Foreground="White" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>