<UserControl x:Class="SysAdm.Views.UserControls.CONTPAQiPlaza"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="840">

    <UserControl.Resources>
        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextBlock FontFamily="{StaticResource MaterialDesignIcons}"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnLimpiar" TargetType="Button" BasedOn="{StaticResource BtnAccion}">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="BorderBrush" Value="#5A6268"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="BtnBuscar" TargetType="Button" BasedOn="{StaticResource BtnAccion}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BUSQUEDA -->
        <GroupBox Grid.Row="0" Header="Búsqueda de Plazas CONTPAQi" Margin="6"
                  Padding="8,6" BorderBrush="#CCCCCC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Buscar por:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <ComboBox x:Name="cmbFiltro" Width="170" Height="26" SelectedIndex="0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Todas las plazas"/>
                        <ComboBoxItem Content="Código de Plaza"/>
                        <ComboBoxItem Content="Código de Trabajador"/>
                        <ComboBoxItem Content="Nombre Completo"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Valor de búsqueda:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="txtBusqueda" Height="26" VerticalContentAlignment="Center" 
                             Padding="4,3" BorderBrush="#CCCCCC" KeyDown="TxtBusqueda_KeyDown"/>
                </StackPanel>

                <Button x:Name="btnLimpiar" Grid.Column="4" Tag="cleaning_services" Content="Limpiar" 
                        Style="{StaticResource BtnLimpiar}" VerticalAlignment="Bottom" Height="26" Width="80" Click="BtnLimpiar_Click"/>

                <Button x:Name="btnBuscar" Grid.Column="6" Tag="search" Content="Buscar"
                        Style="{StaticResource BtnBuscar}" VerticalAlignment="Bottom" Height="26" Width="90" Click="BtnBuscar_Click"/>
            </Grid>
        </GroupBox>

        <!-- DATAGRID CON TODAS LAS COLUMNAS DEL DTO -->
        <DataGrid x:Name="dgvPlazas" Grid.Row="1"
                Margin="6,0,6,6"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="All"
                RowHeaderWidth="35"
                LoadingRow="dgvPlazas_LoadingRow"
                Background="White"
                RowBackground="White"
                AlternatingRowBackground="#F7F9FC"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <!-- Identificadores y Códigos Principales -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Cód. Plaza" Binding="{Binding CodigoPlaza}" Width="100"/>
                <DataGridTextColumn Header="Cód. Trabajador" Binding="{Binding CodigoTrabajador}" Width="110"/>

                <!-- Datos Laborales y Estatus -->
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="60"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoEmpleado}" Width="60"/>
                
                <!-- Nombre Completo del Empleado -->
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="130"/>
                <DataGridTextColumn Header="A. Paterno" Binding="{Binding Paterno}" Width="130"/>
                <DataGridTextColumn Header="A. Materno" Binding="{Binding Materno}" Width="130"/>
                
                <!-- Puesto -->
                <DataGridTextColumn Header="Cód. Puesto" Binding="{Binding CodigoPuesto}" Width="100"/>
                <DataGridTextColumn Header="Puesto" Binding="{Binding NombrePuesto}" Width="260"/>
                
                <!-- Departamento -->
                <DataGridTextColumn Header="Cód. Depto" Binding="{Binding CodigoDepartamento}" Width="100"/>
                <DataGridTextColumn Header="Departamento" Binding="{Binding NombreDepartamento}" Width="260"/>
                
                <!-- Gerencia -->
                <DataGridTextColumn Header="Cód. Gerencia" Binding="{Binding CodigoGerencia}" Width="100"/>
                <DataGridTextColumn Header="Gerencia" Binding="{Binding NombreGerencia}" Width="260"/>
                
                <!-- Dirección -->
                <DataGridTextColumn Header="Cód. Dirección" Binding="{Binding CodigoDireccion}" Width="100"/>
                <DataGridTextColumn Header="Dirección" Binding="{Binding NombreDireccion}" Width="260"/>
                
                <!-- Fechas y Causas -->
                <DataGridTextColumn Header="F. Ingreso" Binding="{Binding FechaIngresoDisplay}" Width="80"/>
                <DataGridTextColumn Header="F. Reingreso" Binding="{Binding FechaReIngresoDisplay}" Width="80"/>
                <DataGridTextColumn Header="F. Baja" Binding="{Binding FechaBajaDisplay}" Width="80"/>
                <DataGridTextColumn Header="Causa Baja" Binding="{Binding CausaBaja}" Width="150"/>
                <DataGridTextColumn Header="Segm. Negocio" Binding="{Binding SegmentoNegocio}" Width="100"/>
            </DataGrid.Columns>

            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Width" Value="35"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#F0F2F5"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Style>
            </DataGrid.RowHeaderStyle>

            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2EDF8"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#333333"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EAEAEA"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#333333"/>
            </DataGrid.Resources>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
    </Grid>
</UserControl>