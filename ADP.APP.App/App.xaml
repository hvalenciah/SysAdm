<Application x:Class="SysAdm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SysAdm.Views"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Definición de la fuente de iconos como recurso global -->
        <FontFamily x:Key="MaterialDesignIcons">pack://application:,,,/assets/fonts/MaterialIcons/#Material Icons</FontFamily>
    </Application.Resources>
</Application>
