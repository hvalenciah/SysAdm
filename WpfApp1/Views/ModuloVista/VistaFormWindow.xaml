<Window x:Class="WpfApp1.Views.UserControls.VistaFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datos de la Vista" Height="480" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Id (Solo lectura)" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtId" IsReadOnly="True" Margin="0,0,0,10" Background="#F0F0F0" Height="24"/>

                <TextBlock Text="Nombre de la Vista *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtNombre" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Router Link (Ruta)" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtRouterLink" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Icono (Clase o nombre del icono)" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtIcon" Margin="0,0,0,10" Height="24"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ID Módulo *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtIdModulo" Height="24"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ID Vista Padre" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtIdVistaPadre" Height="24"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nivel" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtNivel" Margin="0,0,0,10" Height="24" Text="0"/>

                <CheckBox x:Name="chkVisible" Content="Visible" IsChecked="True" Margin="0,5,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnCancelar" Content="Cancelar" Width="80" Height="28" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="80" Height="28" Background="#0078D4" Foreground="White" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>