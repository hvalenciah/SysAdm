<Window x:Class="WpfApp1.Views.UserControls.VistaFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datos de la Vista" Height="360" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Id (Solo lectura al editar)" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtId" IsReadOnly="True" Margin="0,0,0,10" Background="#F0F0F0" Height="24"/>

                <TextBlock Text="Nombre de la Vista *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtNombre" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Ruta / Identificador *" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtRuta" Margin="0,0,0,10" Height="24"/>

                <TextBlock Text="Descripción" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                <TextBox x:Name="txtDescripcion" Margin="0,0,0,10" Height="24"/>

                <CheckBox x:Name="chkHabilitado" Content="Habilitado" IsChecked="True" Margin="0,5,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="80" Height="28" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button Content="Guardar" Width="80" Height="28" Background="#0078D4" Foreground="White" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>