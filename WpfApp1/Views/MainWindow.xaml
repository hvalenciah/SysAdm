<Window x:Class="WpfApp1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="SysAdm" Height="720" Width="1024"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        Icon="/assets/icons/favicon.ico">

    <Window.Resources>
        <!-- Estilo unificado para los Encabezados de Columna -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Estilo unificado para los Encabezados de Fila (Números de Línea) -->
        <Style TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- BARRA DE MENÚ (MENUSTRIP) -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Salir" InputGestureText="Alt+F4" Click="btnSalir_Click"/>
            </MenuItem>

            <MenuItem Header="_Editar">

                <MenuItem Header="_Deshacer" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Rehacer" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Cortar" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copiar" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Pegar" InputGestureText="Ctrl+V"/>
                
            </MenuItem>


            <MenuItem Header="_Buscar">
                <MenuItem Header="_Buscar" InputGestureText="Ctrl+F"/>
            </MenuItem>

            <MenuItem Header="_Ver">
                <MenuItem x:Name="menuVerBarraHerramientas" Header="_Barra de herramientas" IsCheckable="True" IsChecked="True" Click="menuVerBarraHerramientas_Click"/>
                <Separator/>
                <MenuItem x:Name="menuBalcax" Header="_Balcax" IsCheckable="True" IsChecked="True" Click="menuVerToolBar_Click"/>
                <Separator/>
                <MenuItem x:Name="menuVerTabSalida" Header="Panel de _Salida / Diagnóstico" IsCheckable="True" IsChecked="True" Click="menuVerTabSalida_Click"/>
                <MenuItem x:Name="menuVerBarraEstado" Header="_Barra de estado" IsCheckable="True" IsChecked="True" Click="menuVerBarraEstado_Click"/>
            </MenuItem>

            <MenuItem Header="A_yuda">
                <MenuItem Header="_Acerca de..." Click="btnAcercaDe_Click"/>
            </MenuItem>
        </Menu>

        <!-- BARRA DE HERRAMIENTAS (TOOLSTRIP) -->
        <ToolBarTray x:Name="toolBarTrayPrincipal" DockPanel.Dock="Top" Background="#F5F5F5">

            <!-- BARRA 1: ENTRADA Y SALIDA DE DATOS-->
            <ToolBar x:Name="tbBalcax" Band="1" BandIndex="1">
                <Button x:Name="btnBalcaxUsuario" ToolTip="Usuarios Balcax" Click="btnBalcaxUsuario_Click" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/users.png" Width="24" Height="24" Margin="0,0,4,0"/>
                        <TextBlock Text="Usuarios" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnBalcaxModuloVista" ToolTip="Modulos-Vistas Balcax" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/app.png" Width="24" Height="24" Margin="0,0,4,0"/>
                        <TextBlock Text="Modulos-Vistas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCompaqColaboradores" ToolTip="Colaboradores Compaq" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/users.png" Width="24" Height="24" Margin="0,0,4,0"/>
                        <TextBlock Text="Colaboradores" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ToolBar>
            
        </ToolBarTray>

        <!-- BARRA DE ESTADO (STATUSSTRIP) -->
        <StatusBar x:Name="statusBarPrincipal" DockPanel.Dock="Bottom" Background="#E1E1E1" Height="26">
            <!-- LADO IZQUIERDO: Estado y Loader -->
            <StatusBarItem x:Name="sbiEstado" Content="Listo"/>

            <StatusBarItem x:Name="sbiProgreso" Width="150" Visibility="Collapsed">
                <Grid Width="140">
                    <ProgressBar x:Name="pbProgreso" Height="14" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="txtProgreso" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="Black"/>
                </Grid>
            </StatusBarItem>

            <!-- LADO DERECHO: Alineado automáticamente usando HorizontalAlignment="Right" -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">

                    <TextBlock x:Name="sbiLineas" Text="Filas: 0" Margin="5,0"/>
                    <Separator Margin="5,0"/>

                    <TextBlock x:Name="sbiPosicion" Text="Fil: 0, Col: 0" Margin="5,0"/>
                    <Separator Margin="5,0"/>

                    <TextBlock x:Name="sbiCodificacion" Text="ANSI" Margin="5,0"/>
                    <Separator Margin="5,0"/>

                    <TextBlock x:Name="sbiFinLinea" Text="Windows (CR LF)" Margin="5,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- CONTENEDOR PRINCIPAL SPLITCONTAINER -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="100"/>
                <RowDefinition Height="5"/>
                <RowDefinition x:Name="gridRowSalida" Height="1*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- TABCONTROL SUPERIOR (HOJAS DE DATOS / EDITOR) -->
            <TabControl x:Name="tabControlEditor" Grid.Row="0" SelectionChanged="tabControlEditor_SelectionChanged">
                <!-- Se poblará dinámicamente desde C# -->
            </TabControl>

            <!-- SPLITTER DIVISION HORIZONTAL -->
            <GridSplitter x:Name="splitterSalida" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#CCCCCC"/>

            <!-- TABCONTROL INFERIOR (SALIDA / DIAGNÓSTICO) -->
            <TabControl x:Name="tabControlSalida" Grid.Row="2">
                <!-- Pestaña Salida -->
                <TabItem Header="Salida">
                    <TextBox x:Name="txtSalida" Background="#1E1E1E" Foreground="#DCDCDC" 
                             FontFamily="Consolas" FontSize="13" IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

                <!-- Pestaña Errores -->
                <TabItem Header="Errores">
                    <DataGrid x:Name="dgvErrores" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="All" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70"/>
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="150"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Pestaña Mensajes -->
                <TabItem Header="Mensajes">
                    <TextBox x:Name="txtMensajes" FontFamily="Consolas" FontSize="12" IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>
</Window>
