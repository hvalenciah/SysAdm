<Window x:Class="WpfApp1.Views.UserControls.PermisoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfApp1.Models"
        Title="Permiso Vista Usuario" Height="620" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        WindowStyle="None" AllowsTransparency="False" Background="White">
    <Border BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Cabecera / Datos Usuario -->
                <RowDefinition Height="Auto"/> <!-- Instrucción -->
                <RowDefinition Height="*"/>    <!-- Árbol de permisos -->
                <RowDefinition Height="Auto"/> <!-- Botones -->
            </Grid.RowDefinitions>

            <!-- Encabezado y Datos de Usuario -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Permiso Vista Usuario" FontSize="20" FontWeight="SemiBold" Foreground="#333333"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#F55353" 
                            FontWeight="Bold" Cursor="Hand" Click="BtnCerrar_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Usuario: " FontSize="13" Foreground="#555555"/>
                    <TextBlock x:Name="lblUsuario" Text="BERNARDO DE HUERTA BADILLO" FontSize="13" FontWeight="Bold" Foreground="#222222"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Correo: " FontSize="13" Foreground="#555555"/>
                    <TextBlock x:Name="lblCorreo" Text="bdehuerta@aguapuebla.mx" FontSize="13" Foreground="#555555"/>
                </StackPanel>
                
                <Separator Margin="0,15,0,0" Background="#EEEEEE"/>
            </StackPanel>

            <!-- Subtítulo Informativo -->
            <TextBlock Grid.Row="1" Text="Para actualizar los permisos solo marca las casillas y da clic en Actualizar." 
                       FontSize="11.5" Foreground="#777777" Margin="0,0,0,10"/>

            <!-- Contenedor del Árbol de Permisos -->
            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" Padding="5">
                <TreeView x:Name="treePermisos" BorderThickness="0">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type models:PermisoNodoModel}" ItemsSource="{Binding Hijos}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" FontSize="12.5" Foreground="#333333"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <!-- Botones Acción -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Height="38" Background="#F55353" Foreground="White" 
                        FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="Actualizar" Height="38" Background="#00D29D" Foreground="White" 
                        FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnActualizar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>